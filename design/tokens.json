{
  "meta": {
    "name": "Upahgo",
    "version": "2.3.0",
    "date": "2026-11-18",
    "status": "ceria-implementation",
    "platform": "android",
    "scheme": "light",
    "layoutUnit": "dp",
    "typeUnit": "sp",
    "durationUnit": "ms",
    "note": "Ceria design approved for implementation. Original green/gold logo preserved. White canvas, colorful service objects, calm consent and monetary flows."
  },
  "color": {
    "primary": "#087F52",
    "onPrimary": "#FFFFFF",
    "primaryPressed": "#00391B",
    "primaryContainer": "#DDF4EA",
    "onPrimaryContainer": "#014C24",
    "actionText": "#014C24",
    "brandGold": "#E5C282",
    "ratingStar": "#F6BE3A",
    "ratingStarOutline": "#A7740C",
    "onBrandGold": "#49320B",
    "warmContainer": "#FFF0DF",
    "onWarmContainer": "#684509",
    "inverseSurface": "#087F52",
    "onInverseSurface": "#FFFFFF",
    "inverseMuted": "#FFFFFF",
    "background": "#FFFFFF",
    "onBackground": "#20352B",
    "surface": "#FFFFFF",
    "onSurface": "#20352B",
    "surfaceVariant": "#F3F7F4",
    "onSurfaceVariant": "#56665C",
    "outline": "#78877D",
    "outlineVariant": "#E8ECE9",
    "cardOutline": "#E3E7E4",
    "focus": "#087F52",
    "disabledContainer": "#E4EAE6",
    "onDisabledContainer": "#56665C",
    "success": "#17623F",
    "successContainer": "#DFF3E7",
    "warning": "#825000",
    "warningContainer": "#FFF3CE",
    "error": "#AB3434",
    "onError": "#FFFFFF",
    "errorContainer": "#FCE9E5",
    "info": "#275B79",
    "infoContainer": "#E0EFFB",
    "brandGreen": "#014C24",
    "limeContainer": "#E8F3D6",
    "lilacContainer": "#F0EAFB",
    "mapSurface": "#EAF1E8"
  },
  "typography": {
    "fontFamily": "platform-system-sans",
    "weights": { "regular": 400, "medium": 500, "bold": 700 },
    "roles": {
      "headlineMedium": { "fontSize": 30, "lineHeight": 36, "fontWeight": 700 },
      "headlineSmall": { "fontSize": 26, "lineHeight": 34, "fontWeight": 700 },
      "titleLarge": { "fontSize": 20, "lineHeight": 28, "fontWeight": 700 },
      "titleMedium": { "fontSize": 16, "lineHeight": 24, "fontWeight": 600 },
      "bodyLarge": { "fontSize": 16, "lineHeight": 24, "fontWeight": 400 },
      "bodyMedium": { "fontSize": 14, "lineHeight": 21, "fontWeight": 400 },
      "labelLarge": { "fontSize": 16, "lineHeight": 24, "fontWeight": 500 },
      "labelMedium": { "fontSize": 14, "lineHeight": 20, "fontWeight": 500 }
    }
  },
  "spacing": { "xs": 4, "sm": 8, "md": 12, "base": 16, "lg": 20, "xl": 24, "2xl": 32, "3xl": 40, "4xl": 48 },
  "radius": { "small": 10, "control": 14, "button": 16, "card": 20, "sheet": 28, "chip": 24 },
  "border": { "default": 1, "selected": 1, "focus": 2, "focusOffset": 2 },
  "size": {
    "touchTargetMin": 48,
    "touchGapMin": 8,
    "buttonMinHeight": 48,
    "fieldMinHeight": 56,
    "icon": 24,
    "topBarMinHeight": 64,
    "navigationBarMinHeight": 80
  },
  "layout": {
    "mediumMinWidth": 600,
    "expandedMinWidth": 840,
    "compactPadding": 20,
    "mediumPadding": 24,
    "expandedPadding": 32,
    "formMaxWidth": 560,
    "browseMaxWidth": 864,
    "expandedContentMaxWidth": 1200,
    "paneGap": 24
  },
  "motion": {
    "pressDuration": 100,
    "stateDuration": 160,
    "enterDuration": 200,
    "exitDuration": 160,
    "successDuration": 180,
    "customDurationMax": 240,
    "pressScale": 0.98,
    "maxTranslate": 8,
    "standardEasing": [0.2, 0, 0, 1],
    "maxConcurrentCustomAnimations": 2,
    "decorativeLoops": false,
    "listStagger": false,
    "reduceMotion": "instant-state-change-no-transform"
  },
  "elevation": { "content": 0, "appBar": 0, "floatingOverlay": 2, "modal": 3 },
  "brand": {
    "source": "assets/brand/source/upahgo-logo-approved.png",
    "clearSpaceRatio": 0.25,
    "badgeMinSize": 40,
    "onboardingBadgeSize": 120,
    "lockupMinWidth": 160,
    "note": "Ratios refer to visible badge height. Raster source; no vector master. Native icon derivatives require device mask validation."
  },
  "component": {
    "card": { "padding": 16, "gap": 12, "tagGap": 8 },
    "tag": { "paddingHorizontal": 8, "paddingVertical": 4, "visibleMax": 2 },
    "button": { "paddingHorizontal": 20, "paddingVertical": 12, "iconGap": 8 },
    "field": { "paddingHorizontal": 16, "paddingVertical": 16, "helperGap": 8 },
    "marker": { "width": 56, "height": 66, "anchorX": 0.5, "anchorY": 1 }
  },
  "contrastPairs": [
    { "id": "rating-outline-surface", "foreground": "ratingStarOutline", "background": "surface", "minimum": 3 },
    { "id": "rating-outline-container", "foreground": "ratingStarOutline", "background": "surfaceVariant", "minimum": 3 },
    { "id": "negotiable-plain-label", "foreground": "onPrimaryContainer", "background": "surface", "minimum": 4.5 },
    { "id": "icon-surface", "foreground": "primary", "background": "surface", "minimum": 3 },
    { "id": "icon-canvas", "foreground": "primary", "background": "surfaceVariant", "minimum": 3 },
    { "id": "gold-label", "foreground": "onBrandGold", "background": "brandGold", "minimum": 4.5 },
    { "id": "gold-on-green", "foreground": "brandGold", "background": "brandGreen", "minimum": 4.5 },
    { "id": "employer-marker-boundary", "foreground": "brandGreen", "background": "brandGold", "minimum": 3 },
    { "id": "warm-selected-boundary", "foreground": "focus", "background": "warmContainer", "minimum": 3 },
    { "id": "primary-label", "foreground": "onPrimary", "background": "primary", "minimum": 4.5 },
    { "id": "primary-pressed-label", "foreground": "onPrimary", "background": "primaryPressed", "minimum": 4.5 },
    { "id": "primary-boundary", "foreground": "actionText", "background": "surface", "minimum": 3 },
    { "id": "container-label", "foreground": "onPrimaryContainer", "background": "primaryContainer", "minimum": 4.5 },
    { "id": "warm-label", "foreground": "onWarmContainer", "background": "warmContainer", "minimum": 4.5 },
    { "id": "inverse-label", "foreground": "onInverseSurface", "background": "inverseSurface", "minimum": 4.5 },
    { "id": "inverse-secondary", "foreground": "inverseMuted", "background": "inverseSurface", "minimum": 4.5 },
    { "id": "selected-boundary", "foreground": "focus", "background": "primaryContainer", "minimum": 3 },
    { "id": "body-background", "foreground": "onBackground", "background": "background", "minimum": 4.5 },
    { "id": "body-surface", "foreground": "onSurface", "background": "surface", "minimum": 4.5 },
    { "id": "secondary-background", "foreground": "onSurfaceVariant", "background": "background", "minimum": 4.5 },
    { "id": "secondary-surface", "foreground": "onSurfaceVariant", "background": "surface", "minimum": 4.5 },
    { "id": "secondary-container", "foreground": "onSurfaceVariant", "background": "surfaceVariant", "minimum": 4.5 },
    { "id": "link-surface", "foreground": "actionText", "background": "surface", "minimum": 4.5 },
    { "id": "link-background", "foreground": "actionText", "background": "background", "minimum": 4.5 },
    { "id": "field-boundary-surface", "foreground": "outline", "background": "surface", "minimum": 3 },
    { "id": "field-boundary-background", "foreground": "outline", "background": "background", "minimum": 3 },
    { "id": "focus-surface", "foreground": "focus", "background": "surface", "minimum": 3 },
    { "id": "focus-background", "foreground": "focus", "background": "background", "minimum": 3 },
    { "id": "disabled-label", "foreground": "onDisabledContainer", "background": "disabledContainer", "minimum": 4.5 },
    { "id": "success-label", "foreground": "success", "background": "successContainer", "minimum": 4.5 },
    { "id": "warning-label", "foreground": "warning", "background": "warningContainer", "minimum": 4.5 },
    { "id": "error-label", "foreground": "error", "background": "errorContainer", "minimum": 4.5 },
    { "id": "error-filled-label", "foreground": "onError", "background": "error", "minimum": 4.5 },
    { "id": "info-label", "foreground": "info", "background": "infoContainer", "minimum": 4.5 }
  ]
}
