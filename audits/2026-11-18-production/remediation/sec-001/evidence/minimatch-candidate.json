{
  "version": "11.0.9",
  "engines": {
    "node": "20 || >=22"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/commonjs/index.d.ts",
        "default": "./dist/commonjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "brace-expansion": "^5.0.12",
    "@isaacs/nonrecursive-glob-match": "^1.1.0"
  },
  "scripts": {
    "lint": "oxlint --fix src test",
    "snap": "tap",
    "test": "tap",
    "format": "prettier --write .",
    "prepare": "tshy",
    "presnap": "npm run prepare",
    "pretest": "npm run prepare",
    "typedoc": "typedoc --tsconfig .tshy/esm.json ./src/*.ts",
    "postlint": "npm run format",
    "postsnap": "npm run lint",
    "benchmark": "node benchmark/index.js",
    "preversion": "npm test",
    "postversion": "git push origin --follow-tags"
  },
  "license": "BlueOak-1.0.0",
  "dist.integrity": "sha512-KCFkfyjqerNlSstjlhIGNXIKZGA/6O4V4RlhZ+Dsr621SPPw0mzlypE9D9ZOoPiVefHID+j7/XuMMlqfD/F60Q==",
  "dist.tarball": "https://registry.npmjs.org/minimatch/-/minimatch-11.0.9.tgz"
}
